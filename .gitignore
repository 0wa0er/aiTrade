# ---- 依赖（本项目零依赖运行，预防性忽略）----
node_modules/

# ---- 运行时账户状态 ----
# data/state.json 保存现金、持仓、委托、成交，每个交易日都在变。
# 不纳入版本控制：否则每次交易都会产生 diff，commit 历史会被账户流水淹没。
# 需要恢复初始账户时：cp data/state.seed.json data/state.json（先停服务）
data/state.json
data/state.json.tmp
data/*.log

# ---- 区间触发运行时状态 ----
# bands.json 是配置（入库）；下面两个是每个交易日都在变的运行态，不入库。
data/bands.state.json
data/alerts.json
data/agent-runs/

# ---- 实时盯盘运行时 ----
# data/live/ 里是进程锁、每轮快照、事件流水和唤醒日志，都是运行态。
# 计划区归档（data/journal/plan-archive/）是业务记录，要入库，别加进来。
data/live/

# ---- 账户状态手工备份（含现金与持仓快照，不入库）----
data/backup/

# ---- WorkBuddy 运行时数据（记忆、自动化快照）----
.workbuddy/

# ---- 临时文件 ----
*.tmp
.tmp-*
.shot*.png
